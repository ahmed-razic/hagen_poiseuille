FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application         foamRun;

solver              incompressibleFluid;

startFrom           startTime;

startTime           0;

stopAt              endTime;

endTime             20;

deltaT              0.05;   //number of calculations 20 * 0.05 = 400 calculations

writeControl        runTime;

writeInterval       1;

purgeWrite          0;

writeFormat         ascii;

writePrecision      8;

timeFormat          general;

timePrecision       6;

runTimeModifiable   true;

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

functions
{
    minmaxPressureDomain
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        enabled         true;
        log             true;
        writeControl    timeStep;
        writeFields     false;
        select          all;
        operation       none;
        fields 
        (
            p
        );
    }

    minmaxVelocityDomain
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        enabled         true;
        log             true;
        writeControl    timeStep;
        writeFields     false;
        select          all;
        operation       none;
        fields 
        (
            U
        );
    }

    minPressure 
    {
        $minmaxPressureDomain;
        operation       min;
    }

    maxPressure 
    {
        $minmaxPressureDomain;
        operation       max;
    }

    minVelocity
    {
        $minmaxVelocityDomain;
        operation       minMag;
    }

    maxVelocity
    {
        $minmaxVelocityDomain;
        operation       maxMag;
    }


    inletMassFlow
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        enabled         true;
        log             true;
        writeControl    timeStep;
        writeFields     false;
        regionType      patch;
        patch           inlet;
        operation       sum;
        fields
        (
            phi
        );
    }

    outletMassFlow
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        enabled         true;
        log             true;
        writeControl    timeStep;
        writeFields     false;
        regionType      patch;
        patch           outlet;
        operation       sum;
        fields
        (
            phi
        );
    }

    inletWeightedAverage
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        enabled         true;
        log             true;
        writeControl    timeStep;
        writeFields     false;
        regionType      patch;
        patch           inlet;
        operation       average;
        fields
        (
            phi
            U
            p
        );
    }

    outletMax
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        enabled         true;
        log             true;
        writeControl    timeStep;
        writeFields     false;
        regionType      patch;
        patch           outlet;
        operation       max;
        fields
        (
            U
            p
        );
    }
}

