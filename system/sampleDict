FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      sampleDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type                    sets;
libs                    ("libsampling.so");
setFormat               raw;
interpolationScheme     cellPointFace;
fields
(
    U
);

sets
(
    x_line
    {
        type    lineFace;
        axis    x;
        start   (0 0 0);
        end     (10 0 0);
    }
    
    y_line
    {
        type    lineFace;
        axis    y;
        start   (9 -1 0);
        end     (9 1 0);
    }
);

