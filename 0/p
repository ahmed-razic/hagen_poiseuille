FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
dimensions          [0 2 -2 0 0 0 0];

internalField       uniform 0;
//internalField       uniform 101325;

boundaryField
{
    top
    {
        type        zeroGradient;
    }

    bottom
    {
        type        zeroGradient;
    }

    inlet
    {
        //type        zeroGradient;
        type        fixedValue;
        value       uniform 1.53103;
    }

    outlet
    {
        type        fixedValue;
        value       $internalField;
        //type        zeroGradient;     //run this option also
    }

    front
    {
        type        empty;
    }

    back
    {
        type        empty;
    }
}

